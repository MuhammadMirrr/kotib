// ---------------------------------------------------------------- jadval
// Spec «Tekshiruv jadvali», «Oʻrnatish oqimi». Vaqtlar — unix soniya, -1 —
// «hech qachon» (macOS'dagi `nil`).
//
// QAYTA(urinish, kutilgan_soniya) — qaytaUrinishKechikishi; -1: urinishlar
// tugadi, odatdagi 24 soatlik jadvalga qaytiladi.
QAYTA(0, 900)
QAYTA(1, 3600)
QAYTA(2, 14400)
QAYTA(3, -1)
QAYTA(10, -1)
QAYTA(-1, -1)

