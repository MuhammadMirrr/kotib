// Avto-yangilanish mantigʻining UMUMIY test holatlari — macOS va Windows bir xil
// jadvaldan sinaladi:
//   • Windows: win/tests/test_yangilanish.cpp bu faylni `#include` qiladi
//     (X-makro) — jadval kotib-testlar.exe ichiga kompilyatsiya vaqtida kiradi;
//   • macOS: tests/test_yangilanish.swift faylni ish paytida oʻqib tahlil qiladi.
//
// Format: har qator — bitta makro chaqiruvi, argumentlar C literallari
// (satrlar qoʻshtirnoqda, `\"` va `\\` qochish belgilari bilan). Izoh — `//`
// bilan boshlanadigan alohida qator. Bitta holat — bitta qator.
//
// Nega bitta jadval: ikki platforma bir serverdan bir xil manifest oladi va bir
// xil qaror qabul qilishi SHART. Holatlar ikki nusxada yozilsa, bir kun biri
// boshqasidan ajralib qoladi va buni hech kim sezmaydi.
//
// Spec: docs/superpowers/specs/2026-10-07-avto-yangilanish-design.md
// Reja: docs/superpowers/plans/2026-10-07-s2-imzo-va-siyosat.md

// ---------------------------------------------------------------- versiya
// VERSIYA(a, b, kutilgan) — taqqosla(a, b): -1 (a eski) | 0 | 1 (a yangi)
VERSIYA("1.1.0", "1.0.0", 1)
VERSIYA("1.0.0", "1.1.0", -1)
VERSIYA("1.1.0", "1.1.0", 0)
VERSIYA("1.10.0", "1.9.0", 1)
VERSIYA("1.9.0", "1.10.0", -1)
VERSIYA("2.0.0", "1.99.99", 1)
VERSIYA("1.0.1", "1.0.0", 1)
VERSIYA("1.0.0", "0.99.99", 1)
VERSIYA("1.1", "1.0.0", 1)
VERSIYA("1.0", "1.0.0", 0)
VERSIYA("1.0.0", "1.0", 0)
VERSIYA("1.0.0.1", "1.0.0", 1)
VERSIYA("", "1.0.0", -1)
VERSIYA("nomaʼlum", "1.0.0", -1)
VERSIYA("1.0.0", "", 1)
VERSIYA("", "", 0)
VERSIYA("1a.0.0", "1.0.0", -1)
VERSIYA("1.2.99999999999", "1.2.1", 1)
VERSIYA("1.2.0-rc1", "1.2.0", -1)
VERSIYA("1.2.0", "1.2.0-rc1", 1)
VERSIYA("1.2.0-rc1", "1.1.9", 1)
VERSIYA("1.2.0-sinov9", "1.2.0-sinov10", -1)
VERSIYA("1.2.0-sinov2", "1.2.0-sinov1", 1)
VERSIYA("1.2.0-sinov1", "1.2.0-sinov1", 0)
VERSIYA("1.2.0-rc.2", "1.2.0-rc.10", -1)
VERSIYA("1.2.0-rc", "1.2.0-rc.1", -1)
VERSIYA("1.2.0-1", "1.2.0-rc", -1)
VERSIYA("1.2.0-rc01", "1.2.0-rc1", 0)
VERSIYA("1.2.0-alpha", "1.2.0-beta", -1)

// FORMAT(versiya, kutilgan) — manifest va VERSION fayli qabul qiladigan shakl:
// KATTA.KICHIK.TUZATISH[-qoʻshimcha], qoʻshimcha faqat [0-9A-Za-z.]
FORMAT("1.2.0", true)
FORMAT("1.2.0-sinov1", true)
FORMAT("1.2.0-rc.1", true)
FORMAT("01.2.0", true)
FORMAT("1.2", false)
FORMAT("1.2.0.0", false)
FORMAT("v1.2.0", false)
FORMAT("1.2.0-", false)
FORMAT("1.2.0-rc_1", false)
FORMAT("1.2.0-a-b", false)
FORMAT("", false)
FORMAT(" 1.2.0", false)
FORMAT("1..0", false)

// ---------------------------------------------------------------- siyosat
// SIYOSAT(nom, joriy, versiya, min, muhlat_soat, foiz, chelak, korilgan, hozir, kutilgan)
//   min ""         — majburiy chegara yoʻq
//   chelak 0–99    — ilova birinchi ishga tushganda tanlagan tasodifiy son
//   korilgan -1    — majburiy siyosat hali koʻrilmagan; aks holda unix soniya
//   kutilgan       — HECH | YUKLA (oddiy, boʻsh paytda) | ORNAT (majburiy,
//                    darhol) | BLOKLA (muhlat tugadi — diktovka toʻxtaydi)
SIYOSAT("yangi versiya, hammaga", "1.1.0", "1.2.0", "", 72, 100, 50, -1, 1000, YUKLA)
SIYOSAT("oʻzimiz eng yangi", "1.2.0", "1.2.0", "", 72, 100, 0, -1, 1000, HECH)
SIYOSAT("eski versiyaga tushirilmaydi", "1.3.0", "1.2.0", "", 72, 100, 0, -1, 1000, HECH)
SIYOSAT("foiz: chelak ichida", "1.1.0", "1.2.0", "", 72, 10, 9, -1, 1000, YUKLA)
SIYOSAT("foiz: chelak chegarada", "1.1.0", "1.2.0", "", 72, 10, 10, -1, 1000, HECH)
SIYOSAT("foiz 0 — hech kimga", "1.1.0", "1.2.0", "", 72, 0, 0, -1, 1000, HECH)
SIYOSAT("majburiy, hali koʻrilmagan", "1.1.0", "1.2.1", "1.2.0", 72, 100, 50, -1, 1000, ORNAT)
SIYOSAT("majburiy, muhlat ichida", "1.1.0", "1.2.1", "1.2.0", 72, 100, 50, 1000, 260199, ORNAT)
SIYOSAT("majburiy, muhlat tugadi", "1.1.0", "1.2.1", "1.2.0", 72, 100, 50, 1000, 260200, BLOKLA)
SIYOSAT("majburiy, foiz eʼtiborsiz", "1.1.0", "1.2.1", "1.2.0", 72, 0, 99, -1, 1000, ORNAT)
SIYOSAT("majburiy, muhlat 0 — darhol blok", "1.1.0", "1.2.1", "1.2.0", 0, 100, 50, -1, 1000, BLOKLA)
SIYOSAT("majburiy, soat orqaga surilgan", "1.1.0", "1.2.1", "1.2.0", 72, 100, 50, 5000, 1000, ORNAT)
SIYOSAT("min bajarilgan — oddiy yangilanish", "1.2.0", "1.2.1", "1.2.0", 72, 100, 50, -1, 1000, YUKLA)
SIYOSAT("min bajarilgan, foizdan tashqari", "1.2.0", "1.2.1", "1.2.0", 72, 10, 50, -1, 1000, HECH)
SIYOSAT("min > versiya — manifest yaroqsiz", "1.1.0", "1.2.0", "1.3.0", 72, 100, 50, -1, 1000, HECH)
SIYOSAT("sinov kanali", "1.2.0-sinov1", "1.2.0-sinov2", "", 72, 100, 0, -1, 0, YUKLA)
SIYOSAT("rc dan relizga", "1.2.0-rc1", "1.2.0", "", 72, 100, 0, -1, 0, YUKLA)
SIYOSAT("min = versiya, muhlat 0", "1.1.0", "1.2.0", "1.2.0", 0, 100, 0, -1, 0, BLOKLA)

