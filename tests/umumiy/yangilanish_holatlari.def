// MANIFEST(nom, platforma, manifest_json, rejim, kutilgan)
//   Test manifestni RFC 8032 TEST 1 kaliti bilan oʻzi imzolaydi va server
//   javobini {"m": base64(manifest), "s": base64(imzo)} koʻrinishida yasaydi.
//   rejim: TOGRI | BUZUQ_IMZO (imzoning 1 biti) | BUZUQ_XABAR (m ga boʻshliq
//          qoʻshilgan) | BOSHQA_KALIT (TEST 2 ochiq kaliti bilan tekshiriladi)
//   kutilgan: "RAD" yoki tahlil natijasining xulosasi:
//     v=<versiya>;min=<min>;muhlat=<soat>;foiz=<foiz>;izoh=<izoh>
//     va har arxitektura uchun (alifbo tartibida) ;<arx>=<url>|<hajm>|<sha256>|imzo<bayt>
MANIFEST("win: toʻliq, toʻgʻri", "win", "{\"platforma\":\"win\",\"versiya\":\"1.2.1\",\"min_versiya\":\"1.2.0\",\"majburiy_muhlat_soat\":72,\"tarqatish_foiz\":10,\"izoh\":\"Mikrofon ochilishidagi xato tuzatildi.\",\"fayllar\":{\"x64\":{\"url\":\"https://cdn.mirqobilov.com/dl/v1.2.1/Kotib-1.2.1-win-yangilash.exe\",\"hajm\":41234567,\"sha256\":\"9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08\",\"imzo\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\"},\"arm64\":{\"url\":\"https://cdn.mirqobilov.com/dl/v1.2.1/Kotib-1.2.1-win-yangilash-arm64.exe\",\"hajm\":40000000,\"sha256\":\"9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08\",\"imzo\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\"}}}", TOGRI, "v=1.2.1;min=1.2.0;muhlat=72;foiz=10;izoh=Mikrofon ochilishidagi xato tuzatildi.;arm64=https://cdn.mirqobilov.com/dl/v1.2.1/Kotib-1.2.1-win-yangilash-arm64.exe|40000000|9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08|imzo64;x64=https://cdn.mirqobilov.com/dl/v1.2.1/Kotib-1.2.1-win-yangilash.exe|41234567|9f86d081884c7d659a2feaa0c55ad015a3bf4f1b2b0b822cd15d6c15b0f00a08|imzo64")
