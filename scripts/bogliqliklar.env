# Kotib — tashqi bogʻliqliklarning pinlangan versiyalari. YAGONA manba.
#
# Oʻqiydiganlar: setup.sh va win/build-mac.sh (`scripts/bogliqliklar.sh`
# orqali), win/build.ps1 (`ConvertFrom-StringData`), win/cmake/llvm-mingw.cmake.
# Shuning uchun format qatʼiy: faqat `KALIT=qiymat`, qoʻshtirnoqsiz va
# boʻshliqsiz; izoh — alohida qatorda `#` bilan.
#
# Nega pin: ilgari whisper.cpp va CTranslate2 `master` dan klonlanardi. Toza
# mashinada yigʻilgan ilova sinalganidan boshqa kod bilan chiqardi, Windows
# MSVC yoʻli esa umuman boshqa teg (v1.9.2) olardi — ikki platformaning bir
# xil natija berishi kafolatlanmasdi.
#
# Yangilash: commit'ni shu yerda oʻzgartiring → mahalliy nusxani oʻsha
# commit'ga oʻtkazing (skript mos kelmasa buyruqni oʻzi aytadi) → build
# papkalarini oʻchirib qayta yigʻing → ikkala platformada sinang, ayniqsa
# `./win/tests/mac/hammasi.sh` va tarjima sifati (`scripts/eval/`).

# whisper.cpp — 1.1.0 ikkala platformada shu commit bilan yigʻilgan (2026-07-01).
WHISPER_URL=https://github.com/ggml-org/whisper.cpp.git
WHISPER_COMMIT=167d225f3a7ca391d0b79c069c2a887c83232d10

# CTranslate2 — tarjima dvigateli, sinalgan commit (2026-08-30).
CT2_URL=https://github.com/OpenNMT/CTranslate2.git
CT2_COMMIT=af0453f5704ae59a6615f4eaa3c0c1bae40a647c

# SentencePiece — v0.2.0 teg commit'i. ATAYLAB v0.2.0: `master` tashqi
# abseil-cpp ni tortadi (94 ta qoʻshimcha statik kutubxona), v0.2.0 esa uni
# oʻzi bilan olib keladi (2 ta).
SP_URL=https://github.com/google/sentencepiece.git
SP_COMMIT=17d7580d6407802f85855d2cc9190634e2c95624

# llvm-mingw — Windows'ni macOS'da yigʻish uchun (win/build-mac.sh).
LLVM_MINGW_VERSIYA=20260908

# Sparkle — macOS avto-yangilanish (S5) va imzo vositalari (generate_keys,
# sign_update). 2.10.0 (2026-09-13): macOS 27 dagi delta-yangilanish siqilishi
# xatosi tuzatilgan; minimal talab macOS 12 (bizniki 13).
# sha256 — GitHub release asset'ining `digest` qiymati, yuklangan fayl bilan tekshirilgan.
SPARKLE_VERSIYA=2.10.0
SPARKLE_URL=https://github.com/sparkle-project/Sparkle/releases/download/2.10.0/Sparkle-2.10.0.tar.xz
SPARKLE_SHA256=c2bf58aa8387266ac179357b1415d6f2635f044da8be41042af32425dae6da0c

# Silero VAD (ggml) — S12: jimlik/shovqinda whisper chaqirilmaydi, uzun ovoz
# VAD topgan jimliklardan boʻlinadi. Manba — whisper.cpp `models/download-vad-model.sh`
# koʻrsatgan HuggingFace repo, commit bilan pinlangan. Litsenziya MIT. 885 KB:
# ikkala platformada ilova bilan birga (macOS bundle, Windows `{app}`).
VAD_NOM=ggml-silero-v6.2.0.bin
VAD_URL=https://huggingface.co/ggml-org/whisper-vad/resolve/9ffd54a1e1ee413ddf265af9913beaf518d1639b/ggml-silero-v6.2.0.bin
VAD_SHA256=2aa269b785eeb53a82983a20501ddf7c1d9c48e33ab63a41391ac6c9f7fb6987
VAD_HAJM=885098

# Nutq modeli (rubaiSTT v2 medium, ggml q8_0). CDN obyekti immutable.
MODEL_CDN_URL=https://cdn.mirqobilov.com/v1.0/ggml-rubaistt.bin
MODEL_SHA256=1b02df434902015e1464611a7748927e42fcb55c49791c85239cf713c8edc1a3
MODEL_HAJM=823369796
